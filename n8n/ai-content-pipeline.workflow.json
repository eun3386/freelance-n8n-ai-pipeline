{
  "name": "AI 콘텐츠 자동 발행 파이프라인",
  "nodes": [
    {
      "id": "1",
      "name": "매일 09시",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "2",
      "name": "RSS 수집",
      "type": "n8n-nodes-base.rssFeedRead",
      "typeVersion": 1,
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "={{ $env.RSS_URL || 'https://news.google.com/rss/search?q=AI+automation&hl=ko&gl=KR&ceid=KR:ko' }}"
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "id": "3",
      "name": "키워드 필터 + 중복 제거",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "// 키워드가 포함된 기사만 남기고, 이미 발행한 링크는 제외(Workflow Static Data)\nconst keywords = ($env.KEYWORDS || 'AI,자동화,n8n').split(',').map(s => s.trim().toLowerCase());\nconst store = $getWorkflowStaticData('global');\nstore.seen = store.seen || [];\nconst out = [];\nfor (const item of $input.all()) {\n  const { title = '', link = '', contentSnippet = '', content = '' } = item.json;\n  const text = (title + ' ' + contentSnippet).toLowerCase();\n  if (!keywords.some(k => text.includes(k))) continue;\n  if (store.seen.includes(link)) continue;\n  store.seen.push(link);\n  out.push({ json: { title, link, content: contentSnippet || content } });\n}\nstore.seen = store.seen.slice(-500);\nreturn out.slice(0, Number($env.MAX_POSTS || 10));"
      }
    },
    {
      "id": "4",
      "name": "LLM 요약/작성",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $env.ANTHROPIC_API_KEY }}"
            },
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({model:'claude-haiku-5-5',max_tokens:700,messages:[{role:'user',content:'다음 기사를 한국어 블로그 글로 작성해줘. 첫 줄은 제목, 이후 3문단 요약과 핵심 포인트 3개. 원문 링크는 마지막에 표기.\\n\\n제목: '+$json.title+'\\n본문: '+$json.content+'\\n링크: '+$json.link}]}) }}",
        "options": {
          "timeout": 60000
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "5",
      "name": "글 포맷 정리",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        -100
      ],
      "parameters": {
        "jsCode": "const src = $('키워드 필터 + 중복 제거').all();\nreturn $input.all().map((it, i) => {\n  const text = it.json.content?.[0]?.text ?? '';\n  const [title, ...rest] = text.split('\\n').filter(Boolean);\n  return { json: { title: title.replace(/^#+\\s*/, ''), html: rest.join('<br>'), link: src[i]?.json.link } };\n});"
      }
    },
    {
      "id": "6",
      "name": "워드프레스 발행",
      "type": "n8n-nodes-base.wordpress",
      "typeVersion": 1,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "title": "={{ $json.title }}",
        "additionalFields": {
          "content": "={{ $json.html }}",
          "status": "publish"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "wordpressApi": {
          "id": "REPLACE_ME",
          "name": "WordPress"
        }
      }
    },
    {
      "id": "7",
      "name": "슬랙 완료 알림",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        1320,
        -100
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#auto-publish"
        },
        "text": "=✅ 발행 완료: {{ $json.title?.rendered || $json.title }}"
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "Slack"
        }
      }
    },
    {
      "id": "8",
      "name": "LLM 실패 격리",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        880,
        120
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#auto-publish"
        },
        "text": "=⚠️ LLM 호출 3회 재시도 실패, 건너뜀: {{ $json.error?.message }}"
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "Slack"
        }
      }
    },
    {
      "id": "9",
      "name": "에러 트리거",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ],
      "parameters": {}
    },
    {
      "id": "10",
      "name": "에러 알림",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "select": "channel",
        "channelId": {
          "__rl": true,
          "mode": "name",
          "value": "#auto-publish"
        },
        "text": "=🚨 워크플로우 실패: {{ $json.workflow.name }} / 노드: {{ $json.execution.lastNodeExecuted }} / {{ $json.execution.error.message }}"
      },
      "credentials": {
        "slackApi": {
          "id": "REPLACE_ME",
          "name": "Slack"
        }
      }
    }
  ],
